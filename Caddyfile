{
	servers {
		trusted_proxies static private_ranges
	}
	order powgate before file_server
	order rate_limit before powgate
}

(basehdrs) {
	header {
		-Server
		-X-Powered-By
		-Last-Modified
		-ETag
		X-Content-Type-Options nosniff
		X-Robots-Tag noindex
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		Permissions-Policy "interest-cohort=()"
	}
}

:8080 {
	log {
		output stdout
		format json
	}

	import basehdrs

	@health path /health
	handle @health {
		@siteok file {
			root /srv
			try_files index.html
		}
		handle @siteok {
			header Content-Type text/plain
			header Cache-Control no-store
			respond "up" 200
		}
		handle {
			header Content-Type text/plain
			header Cache-Control no-store
			respond "degraded" 503
		}
	}

	@nosecfetch not header Sec-Fetch-Mode *
	handle @nosecfetch {
		respond 404
	}

	@nolang not header Accept-Language *
	handle @nolang {
		respond 404
	}

	@noenc not header Accept-Encoding *
	handle @noenc {
		respond 404
	}

	@nomozilla not header_regexp User-Agent "(?i)mozilla/5\.0"
	handle @nomozilla {
		respond 404
	}

	@badtool header_regexp User-Agent "(?i)(curl|wget|python|libwww|http[-_]?client|go-http|okhttp|java/|apache-http|scrapy|httpx|aiohttp|axios|node-fetch|got/|reqwest|guzzle|postman|insomnia|headless|phantom|puppeteer|playwright|selenium|\bbot\b|spider|crawl)"
	handle @badtool {
		respond 404
	}

	@conditional expression `{header.If-Modified-Since} != "" || {header.If-None-Match} != "" || {header.If-Match} != "" || {header.If-Unmodified-Since} != "" || {header.If-Range} != ""`
	handle @conditional {
		respond 404
	}

	@nonget not method GET HEAD
	handle @nonget {
		respond 404
	}

	@favicon path /favicon.ico
	handle @favicon {
		respond 204
	}

	@cfg path /c
	handle @cfg {
		header Content-Type text/plain
		header Cache-Control no-store
		respond "{$ALLOWED_DOMAIN:}" 200
	}

	handle / {
		rate_limit {
			zone perip {
				key {client_ip}
				events {$RL_EVENTS:120}
				window {$RL_WINDOW:1m}
			}
		}

		powgate {
			secret "{$POW_SECRET}"
			difficulty {$POW_DIFFICULTY:16}
			ttl {$POW_TTL:30m}
		}

		root * /srv
		encode zstd gzip
		file_server

		header Cache-Control "no-cache"
	}

	handle {
		respond 404
	}

	handle_errors 429 {
		import basehdrs
		header -Cache-Control
		header -Retry-After
		respond 404
	}
}
